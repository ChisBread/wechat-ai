#!/usr/bin/with-contenv bash
set -e

if [ "${BOT_ENABLED:-true}" != "true" ]; then
    echo "[wechat-ai] BOT_ENABLED is not true; bot service sleeping"
    exec sleep infinity
fi

export DISPLAY="${DISPLAY:-:1}"
export HOME="${HOME:-/config}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/config/.XDG}"
export BOT_RUN_USER="${BOT_RUN_USER:-root}"

exec /scripts/start-bot.sh
