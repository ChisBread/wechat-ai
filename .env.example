# Ports
HTTP_PORT=3100
HTTPS_PORT=3101
MCP_PORT=8100
SELKIES_MANUAL_WIDTH=1920
SELKIES_MANUAL_HEIGHT=1916

# User/Group
PUID=1000
PGID=100
TZ=Asia/Shanghai
LANG=zh_CN.UTF-8
LANGUAGE=zh_CN:zh
LC_ALL=zh_CN.UTF-8

# Selkies Web UI
# CUSTOM_USER=
# PASSWORD=

# App auto-start
AUTO_START_WECHAT=true

# Bot
BOT_ENABLED=true

# Dashboard auth
# wechat/wechat is only a placeholder and is rejected by the app.
WECHAT_AI_DASHBOARD_USERNAME=wechat
WECHAT_AI_DASHBOARD_PASSWORD=wechat

# MCP safety gates
# wechat is only a placeholder and is rejected by the app.
WECHAT_AI_MCP_TOKEN=wechat
# Enable these only for trusted local clients.
WECHAT_AI_MCP_ADMIN_ENABLED=false
WECHAT_AI_MCP_WRITE_ENABLED=false

# Shared Memory (2gb recommended for AI + browser)
SHM_SIZE=2gb
